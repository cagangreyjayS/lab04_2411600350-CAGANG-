<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Portal - Advanced Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary-custom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="#">Student Portal</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item"><span class="navbar-text text-white me-lg-3">Welcome, <span id="userName">User</span></span></li>
        <li class="nav-item"><button class="btn btn-outline-light btn-sm" id="logoutBtn">Logout</button></li>
      </ul>
    </div>
  </div>
</nav>

<div class="container-fluid">
  <div class="row">
    <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-3">
      <div class="position-sticky">
        <ul class="nav flex-column gap-1">
          <li class="nav-item"><a class="nav-link active" href="#overview">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="#analytics">Analytics</a></li>
          <li class="nav-item"><a class="nav-link" href="#activity">Recent Activity</a></li>
          <li class="nav-item"><a class="nav-link" href="#filters">Filters</a></li>
          <li class="nav-item"><a class="nav-link text-danger" href="#" id="logoutLink">Logout</a></li>
        </ul>
      </div>
    </nav>

    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
      <section id="overview">
        <div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
          <div>
            <h2 id="greeting">Good Morning, User!</h2>
            <p class="text-muted mb-0">Interactive Student Performance Dashboard</p>
          </div>
          <div class="small text-muted">Last update: <span id="lastUpdated">--</span></div>
        </div>
      </section>

      <div id="lowStockAlert" class="alert alert-warning d-none" role="alert"></div>

      <section class="row mb-4" id="statCards">
        <div class="col-sm-6 col-xl-3 mb-3"><div class="card stat-card text-center h-100"><div class="card-body"><h5 class="text-muted" id="stat1-title">GPA</h5><h2 class="fw-bold text-primary" id="stat1-value">0.00</h2></div></div></div>
        <div class="col-sm-6 col-xl-3 mb-3"><div class="card stat-card text-center h-100"><div class="card-body"><h5 class="text-muted" id="stat2-title">Courses</h5><h2 class="fw-bold text-success" id="stat2-value">0</h2></div></div></div>
        <div class="col-sm-6 col-xl-3 mb-3"><div class="card stat-card text-center h-100"><div class="card-body"><h5 class="text-muted" id="stat3-title">Assignments</h5><h2 class="fw-bold text-info" id="stat3-value">0</h2></div></div></div>
        <div class="col-sm-6 col-xl-3 mb-3"><div class="card stat-card text-center h-100"><div class="card-body"><h5 class="text-muted" id="stat4-title">Attendance</h5><h2 class="fw-bold text-warning" id="stat4-value">0%</h2></div></div></div>
      </section>

      <section id="analytics" class="mb-4">
        <div class="row g-4">
          <div class="col-lg-6"><div class="card chart-card h-100"><div class="card-header"><h5 class="mb-0">Course Performance</h5></div><div class="card-body"><div class="chart-container"><canvas id="performanceChart"></canvas></div></div></div></div>
          <div class="col-lg-6"><div class="card chart-card h-100"><div class="card-header"><h5 class="mb-0">Assignment Status</h5></div><div class="card-body"><div class="chart-container"><canvas id="assignmentChart"></canvas></div></div></div></div>
          <div class="col-lg-12"><div class="card chart-card"><div class="card-header"><h5 class="mb-0">Attendance Trend</h5></div><div class="card-body"><div class="chart-container chart-wide"><canvas id="attendanceChart"></canvas></div></div></div></div>
        </div>
      </section>

      <section id="filters" class="card mb-4">
        <div class="card-header"><h5 class="mb-0">Advanced Filters & Search</h5></div>
        <div class="card-body">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label for="searchInput" class="form-label">Search</label>
              <input id="searchInput" class="form-control" type="search" placeholder="Search course or activity..." autocomplete="off">
            </div>
            <div class="col-md-3">
              <label for="categoryFilter" class="form-label">Category</label>
              <select id="categoryFilter" class="form-select"><option value="all">All categories</option></select>
            </div>
            <div class="col-md-2">
              <label for="statusFilter" class="form-label">Status</label>
              <select id="statusFilter" class="form-select">
                <option value="all">All</option><option value="completed">Completed</option><option value="pending">Pending</option><option value="overdue">Overdue</option>
              </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
              <button class="btn btn-outline-secondary flex-fill" id="resetFilters">Reset</button>
              <button class="btn btn-success flex-fill" id="exportCsvBtn">Export CSV</button>
            </div>
          </div>
          <div class="row mt-2"><div class="col-12"><small class="text-muted"><span id="resultCount">0</span> activities shown</small></div></div>
        </div>
      </section>

      <section id="activity" class="card">
        <div class="card-header"><h5 class="mb-0">Recent Activity</h5></div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
              <thead><tr><th>Date</th><th>Category</th><th>Activity</th><th>Status</th><th>Score</th></tr></thead>
              <tbody id="activityTableBody"></tbody>
            </table>
          </div>
          <div id="emptyState" class="text-center text-muted py-4 d-none">No activities match your filters.</div>
        </div>
      </section>
    </main>
  </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="updateToast" class="toast" role="status">
    <div class="toast-header"><strong class="me-auto">Dashboard Update</strong><button type="button" class="btn-close" data-bs-dismiss="toast"></button></div>
    <div class="toast-body" id="toastMessage">Data updated.</div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="js/dataManager.js"></script>
<script src="js/dashboard.js"></script>
</body>
</html>
